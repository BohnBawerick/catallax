+TEST(GeomLib_CheckCurveOnSurfaceTest, SurfaceKnotsPreserveNarrowMaximum)
+{
+  constexpr double aHeight = 1.0e-6;
+  for (const int anExponent : {-12, -30, -42})
+  {
+    SCOPED_TRACE(anExponent);
+    const double aWidth        = std::ldexp(1.0, anExponent);
+    const double aPeak         = 5.0 / 16.0;
+    const double aKnotValues[] = {0.0, aPeak - aWidth, aPeak, aPeak + aWidth, 1.0};
+    const int    aMultValues[] = {2, 1, 1, 1, 2};
+    const NCollection_Array1<double> aKnots(aKnotValues[0], 1, 5);
+    const NCollection_Array1<int>    aMults(aMultValues[0], 1, 5);
+    const double                     aBoundValues[] = {0.0, 1.0};
+    const int                        aBoundMults[]  = {2, 2};
+    const NCollection_Array1<double> aBounds(aBoundValues[0], 1, 2);
+    const NCollection_Array1<int>    aLinearMults(aBoundMults[0], 1, 2);
+    for (const bool isU : {false, true})
+    {
+      for (const bool isReversed : {false, true})
+      {
+        SCOPED_TRACE(isU);
+        SCOPED_TRACE(isReversed);
+        NCollection_Array2<gp_Pnt> aSurfacePoles(1, isU ? 5 : 2, 1, isU ? 2 : 5);
+        for (size_t anIndex = 0; anIndex < 5; ++anIndex)
+        {
+          for (size_t anOther = 0; anOther < 2; ++anOther)
+          {
+            const gp_Pnt aPoint(isU ? aKnots.At(anIndex) : double(anOther),
+                                isU ? double(anOther) : aKnots.At(anIndex),
+                                anIndex == 2 ? aHeight : 0.0);
+            aSurfacePoles.ChangeAt(isU ? anIndex : anOther, isU ? anOther : anIndex) = aPoint;
+          }
+        }
+        const occ::handle<Geom_BSplineSurface> aSurface =
+          new Geom_BSplineSurface(aSurfacePoles,
+                                  isU ? aKnots : aBounds,
+                                  isU ? aBounds : aKnots,
+                                  isU ? aMults : aLinearMults,
+                                  isU ? aLinearMults : aMults,
+                                  1,
+                                  1);
+        NCollection_Array1<gp_Pnt>   aCurvePoles(1, 2);
+        NCollection_Array1<gp_Pnt2d> aPCurvePoles(1, 2);
+        for (size_t anIndex = 0; anIndex < 2; ++anIndex)
+        {
+          const double   aCoordinate = double(isReversed ? 1 - anIndex : anIndex);
+          const gp_Pnt2d aUV(isU ? aCoordinate : 0.25, isU ? 0.25 : aCoordinate);
+          aPCurvePoles.ChangeAt(anIndex) = aUV;
+          aCurvePoles.ChangeAt(anIndex)  = gp_Pnt(aUV.X(), aUV.Y(), 0.0);
+        }
+        const occ::handle<Geom_BSplineCurve> aCurve =
+          new Geom_BSplineCurve(aCurvePoles, aBounds, aLinearMults, 1);
+        const occ::handle<Geom2d_BSplineCurve> aPCurve =
+          new Geom2d_BSplineCurve(aPCurvePoles, aBounds, aLinearMults, 1);
+        const occ::handle<Adaptor3d_CurveOnSurface> aCoS =
+          new Adaptor3d_CurveOnSurface(new Geom2dAdaptor_Curve(aPCurve),
+                                       new GeomAdaptor_Surface(aSurface));
+        EXPECT_EQ(aCoS->NbIntervals(GeomAbs_CN), 4);
+        GeomLib_CheckCurveOnSurface aCheck(new GeomAdaptor_Curve(aCurve));
+        for (const bool isParallel : {false, true})
+        {
+          SCOPED_TRACE(isParallel);
+          aCheck.SetParallel(isParallel);
+          aCheck.Perform(aCoS);
+          ASSERT_TRUE(aCheck.IsDone());
+          EXPECT_NEAR(aCheck.MaxDistance(), aHeight, 1.0e-12);
+          EXPECT_NEAR(aCheck.MaxParameter(), isReversed ? 1.0 - aPeak : aPeak, aWidth);
+          aCheck.Perform(aCoS, 0.5 * aHeight);
+          ASSERT_TRUE(aCheck.IsDone());
+          EXPECT_GT(aCheck.MaxDistance(), 0.5 * aHeight);
+        }
+        const double aTrimLast = 0.25;
+        aCheck.Init(new GeomAdaptor_Curve(aCurve, 0.0, aTrimLast));
+        aCheck.Perform(
+          new Adaptor3d_CurveOnSurface(new Geom2dAdaptor_Curve(aPCurve, 0.0, aTrimLast),
+                                       new GeomAdaptor_Surface(aSurface)));
+        ASSERT_TRUE(aCheck.IsDone());
+        EXPECT_NEAR(aCheck.MaxDistance(), 0.0, 1.0e-12);
+      }
+    }
+  }
