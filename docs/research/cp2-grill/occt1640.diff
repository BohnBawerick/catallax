+TEST(GeomLib_CheckCurveOnSurfaceTest, CurveResidualPreservesEndSpanContinuation)
+{
+  constexpr double           aGap = 0.125;
+  NCollection_Array1<double> aCurveKnots(size_t{2}), aSurfaceUKnots(size_t{2}),
+    aSurfaceVKnots(size_t{2});
+  aCurveKnots.ChangeAt(0)    = 1.0;
+  aCurveKnots.ChangeAt(1)    = 2.0;
+  aSurfaceUKnots.ChangeAt(0) = -1.0;
+  aSurfaceUKnots.ChangeAt(1) = 2.0;
+  aSurfaceVKnots.ChangeAt(0) = 0.0;
+  aSurfaceVKnots.ChangeAt(1) = 1.0;
+  NCollection_Array1<int> aCubicMults(size_t{2}), aLinearMults(size_t{2});
+  aCubicMults.Init(4);
+  aLinearMults.Init(2);
+  NCollection_Array1<double> aWeights(size_t{4});
+  aWeights.Init(1.0);
+  aWeights.ChangeAt(3) = 2.0;
+  NCollection_Array1<gp_Pnt2d> aUVPoles(size_t{2});
+  aUVPoles.ChangeAt(0) = gp_Pnt2d(0.0, 0.0);
+  aUVPoles.ChangeAt(1) = gp_Pnt2d(1.0, 0.0);
+  const occ::handle<Geom2d_BSplineCurve> aPCurveGeometry =
+    new Geom2d_BSplineCurve(aUVPoles, aCurveKnots, aLinearMults, 1);
+  for (const double anOrigin : {0.0, 1.0e12})
+  {
+    SCOPED_TRACE(anOrigin);
+    NCollection_Array1<gp_Pnt> aPoles(size_t{4});
+    aPoles.Init(gp_Pnt(anOrigin, -anOrigin, 0.0));
+    aPoles.ChangeAt(3).SetZ(aGap);
+    NCollection_Array2<gp_Pnt> aSurfacePoles(size_t{2}, size_t{2});
+    aSurfacePoles.Init(gp_Pnt(anOrigin, -anOrigin, 0.0));
+    const occ::handle<GeomAdaptor_Surface> aSurface =
+      new GeomAdaptor_Surface(new Geom_BSplineSurface(aSurfacePoles,
+                                                      aSurfaceUKnots,
+                                                      aSurfaceVKnots,
+                                                      aLinearMults,
+                                                      aLinearMults,
+                                                      1,
+                                                      1));
+    for (const bool isRational : {false, true})
+    {
+      SCOPED_TRACE(isRational);
+      const occ::handle<Geom_BSplineCurve> aCurveGeometry =
+        isRational ? new Geom_BSplineCurve(aPoles, aWeights, aCurveKnots, aCubicMults, 3)
+                   : new Geom_BSplineCurve(aPoles, aCurveKnots, aCubicMults, 3);
+      const std::array<std::pair<double, double>, 2> aRanges = {
+        std::pair{std::nextafter(1.0, 0.0), std::nextafter(2.0, 3.0)},
+        std::pair{0.75, 2.25}};
+      for (const auto& [aFirst, aLast] : aRanges)
+      {
+        SCOPED_TRACE(aFirst);
+        SCOPED_TRACE(aLast);
+        const occ::handle<GeomAdaptor_Curve> aCurve =
+          new GeomAdaptor_Curve(aCurveGeometry, aFirst, aLast);
+        for (const bool isPlane : {false, true})
+        {
+          SCOPED_TRACE(isPlane);
+          const occ::handle<GeomAdaptor_Surface> aSupport =
+            isPlane ? new GeomAdaptor_Surface(
+                        new Geom_Plane(gp_Pnt(anOrigin, -anOrigin, 0.0), gp_Dir(0.0, 0.0, 1.0)))
+                    : aSurface;
+          const occ::handle<Adaptor3d_CurveOnSurface> aCoS =
+            new Adaptor3d_CurveOnSurface(new Geom2dAdaptor_Curve(aPCurveGeometry, aFirst, aLast),
+                                         aSupport);
+          const double aCube      = std::pow(aLast - 1.0, 3);
+          const double aZ         = isRational ? 2.0 * aGap * aCube / (1.0 + aCube) : aGap * aCube;
+          const double anExpected = isPlane ? std::hypot(aLast - 1.0, aZ) : aZ;
+          GeomLib_CheckCurveOnSurface aCheck(aCurve);
+          aCheck.Perform(aCoS);
+          ASSERT_TRUE(aCheck.IsDone());
+          EXPECT_NEAR(aCheck.MaxDistance(), anExpected, Epsilon(anExpected));
+          EXPECT_DOUBLE_EQ(aCheck.MaxParameter(), aLast);
+        }
+      }
+    }
+  }
+}
