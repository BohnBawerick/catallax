+TEST(GeomLib_CheckCurveOnSurfaceTest, SurfaceDegreePreservesInteriorMaximum)
+{
+  const int                        aDegree           = Geom_BSplineSurface::MaxDegree();
+  const double                     aKnotValues[]     = {0.0, 1.0};
+  const int                        aHighMultValues[] = {aDegree + 1, aDegree + 1};
+  const int                        aLowMultValues[]  = {2, 2};
+  const NCollection_Array1<double> aKnots(aKnotValues[0], 1, 2);
+  const NCollection_Array1<int>    aHighMults(aHighMultValues[0], 1, 2);
+  const NCollection_Array1<int>    aLowMults(aLowMultValues[0], 1, 2);
+  for (const bool isV : {false, true})
+  {
+    NCollection_Array2<gp_Pnt> aPoles(1, isV ? 2 : aDegree + 1, 1, isV ? aDegree + 1 : 2);
+    for (int anIndex = 0; anIndex <= aDegree; ++anIndex)
+    {
+      // The first Bernstein term has a higher peak than the central term.
+      const double aHeight = anIndex == 1 ? 1.0 : anIndex == aDegree / 2 ? 2.0 : 0.0;
+      for (int aColumn = 0; aColumn < 2; ++aColumn)
+      {
+        const double aCoordinate = double(anIndex) / aDegree;
+        aPoles.ChangeAt(isV ? aColumn : anIndex, isV ? anIndex : aColumn) =
+          gp_Pnt(isV ? double(aColumn) : aCoordinate, isV ? aCoordinate : double(aColumn), aHeight);
+      }
+    }
+    for (const bool isBezierSurface : {false, true})
+    {
+      const occ::handle<Geom_Surface> aSurface =
+        isBezierSurface
+          ? occ::handle<Geom_Surface>(new Geom_BezierSurface(aPoles))
+          : occ::handle<Geom_Surface>(new Geom_BSplineSurface(aPoles,
+                                                              aKnots,
+                                                              aKnots,
+                                                              isV ? aLowMults : aHighMults,
+                                                              isV ? aHighMults : aLowMults,
+                                                              isV ? 1 : aDegree,
+                                                              isV ? aDegree : 1));
+      for (const int aPCurveDegree : {1, 3})
+      {
+        for (const bool isReversed : {false, true})
+        {
+          NCollection_Array1<gp_Pnt>   aCurvePoles(1, aPCurveDegree + 1);
+          NCollection_Array1<gp_Pnt2d> aPCurvePoles(1, aPCurveDegree + 1);
+          for (int anIndex = 0; anIndex <= aPCurveDegree; ++anIndex)
+          {
+            double aCoordinate = anIndex == aPCurveDegree ? 1.0 : 0.0;
+            if (isReversed)
+            {
+              aCoordinate = 1.0 - aCoordinate;
+            }
+            aPCurvePoles.ChangeAt(anIndex) =
+              gp_Pnt2d(isV ? 0.0 : aCoordinate, isV ? aCoordinate : 0.0);
+            aCurvePoles.ChangeAt(anIndex) =
+              gp_Pnt(aPCurvePoles.At(anIndex).X(), aPCurvePoles.At(anIndex).Y(), 0.0);
+          }
+          const occ::handle<Geom_Curve> aCurve = new Geom_BezierCurve(aCurvePoles);
+          const int aPCurveMultValues[]        = {aPCurveDegree + 1, aPCurveDegree + 1};
+          const NCollection_Array1<int> aPCurveMults(aPCurveMultValues[0], 1, 2);
+          for (const GeomAbs_CurveType aPCurveType :
+               {GeomAbs_BSplineCurve, GeomAbs_BezierCurve, GeomAbs_Line})
+          {
+            if (aPCurveType == GeomAbs_Line && aPCurveDegree != 1)
+            {
+              continue;
+            }
+            SCOPED_TRACE(isV);
+            SCOPED_TRACE(isBezierSurface);
+            SCOPED_TRACE(aPCurveDegree);
+            SCOPED_TRACE(isReversed);
+            SCOPED_TRACE(aPCurveType);
+            occ::handle<Geom2d_Curve> aPCurve;
+            if (aPCurveType == GeomAbs_BSplineCurve)
+            {
+              aPCurve = new Geom2d_BSplineCurve(aPCurvePoles, aKnots, aPCurveMults, aPCurveDegree);
+            }
+            else if (aPCurveType == GeomAbs_BezierCurve)
+            {
+              aPCurve = new Geom2d_BezierCurve(aPCurvePoles);
+            }
+            else
+            {
+              const gp_Dir2d aDirection(aPCurvePoles.Last().XY() - aPCurvePoles.First().XY());
+              aPCurve = new Geom2d_Line(gp_Lin2d(aPCurvePoles.First(), aDirection));
+            }
+            const double aKnownCoordinate = 1.0 / (aDegree + 1);
+            const double aKnownParameter =
+              std::pow(isReversed ? 1.0 - aKnownCoordinate : aKnownCoordinate, 1.0 / aPCurveDegree);
+            const gp_Pnt2d aUV = aPCurve->EvalD0(aKnownParameter);
+            const double   aKnownDistance =
+              aSurface->EvalD0(aUV.X(), aUV.Y()).Distance(aCurve->EvalD0(aKnownParameter));
+            const occ::handle<Adaptor3d_CurveOnSurface> aCoS =
+              new Adaptor3d_CurveOnSurface(new Geom2dAdaptor_Curve(aPCurve, 0.0, 1.0),
+                                           new GeomAdaptor_Surface(aSurface));
+            GeomLib_CheckCurveOnSurface aCheck(new GeomAdaptor_Curve(aCurve, 0.0, 1.0));
+            aCheck.Perform(aCoS);
+            ASSERT_TRUE(aCheck.IsDone());
+            EXPECT_GE(aCheck.MaxDistance(), aKnownDistance);
+          }
+        }
+      }
+    }
