+TEST(GeomLib_CheckCurveOnSurfaceTest, DenseNonuniformKnotsPreserveNarrowMaximum)
+{
+  constexpr double aHeight = 1.0e-6;
+  const double     aWidth  = std::ldexp(1.0, -30);
+  for (const int aNbKnots : {100, 101, 102, 128})
+  {
+    for (const bool isPeriodic : {false, true})
+    {
+      SCOPED_TRACE(aNbKnots);
+      SCOPED_TRACE(isPeriodic);
+      NCollection_Array1<double> aKnots(1, aNbKnots);
+      NCollection_Array1<int>    aMults(1, aNbKnots);
+      aMults.Init(1);
+      for (size_t anIndex = 0; anIndex < aKnots.Size(); ++anIndex)
+      {
+        aKnots.ChangeAt(anIndex) = double(anIndex) / (aNbKnots - 1);
+      }
+      const size_t aPeakIndex         = size_t(0.317 * (aNbKnots - 1));
+      aKnots.ChangeAt(aPeakIndex - 1) = 0.317;
+      aKnots.ChangeAt(aPeakIndex)     = 0.317 + aWidth;
+      aKnots.ChangeAt(aPeakIndex + 1) = 0.317 + 2.0 * aWidth;
+      NCollection_Array1<gp_Pnt> aPoles(1, aNbKnots - int(isPeriodic));
+      aPoles.Init(gp_Pnt(0.0, 0.0, 0.0));
+      aPoles.ChangeAt(aPeakIndex).SetZ(aHeight);
+      if (!isPeriodic)
+      {
+        aMults.ChangeAt(0)                 = 2;
+        aMults.ChangeAt(aMults.Size() - 1) = 2;
+      }
+      const occ::handle<Geom_BSplineCurve> aSpline =
+        new Geom_BSplineCurve(aPoles, aKnots, aMults, 1, isPeriodic);
+      NCollection_Array1<gp_Pnt2d> aUVPoles(1, aPoles.Length());
+      aUVPoles.Init(gp_Pnt2d(0.0, 0.0));
+      aUVPoles.ChangeAt(aPeakIndex).SetY(aHeight);
+      const occ::handle<Geom2d_BSplineCurve> aUVSpline =
+        new Geom2d_BSplineCurve(aUVPoles, aKnots, aMults, 1, isPeriodic);
+      NCollection_Array1<gp_Pnt> aFlatPoles(1, 2);
+      aFlatPoles.Init(gp_Pnt(0.0, 0.0, 0.0));
+      const occ::handle<Geom_BezierCurve> aFlatCurve = new Geom_BezierCurve(aFlatPoles);
+      NCollection_Array1<gp_Pnt2d>        aFlatUVPoles(1, 2);
+      aFlatUVPoles.Init(gp_Pnt2d(0.0, 0.0));
+      const occ::handle<Geom2d_BezierCurve> aFlatPCurve = new Geom2d_BezierCurve(aFlatUVPoles);
+      for (const double aShift : {-1.0, 0.0, 1.0})
+      {
+        if (!isPeriodic && aShift != 0.0)
+        {
+          continue;
+        }
+        SCOPED_TRACE(aShift);
+        const double aPeakParameter = aKnots.At(aPeakIndex) + aShift;
+        ASSERT_NEAR(aSpline->EvalD0(aPeakParameter).Z(), aHeight, 1.0e-12);
+        ASSERT_NEAR(aUVSpline->EvalD0(aPeakParameter).Y(), aHeight, 1.0e-12);
+        const double aFirst = isPeriodic ? aShift + 0.30 : 0.0;
+        const double aLast  = isPeriodic ? aShift + 0.34 : 1.0;
+        for (const bool isPCurvePeak : {false, true})
+        {
+          SCOPED_TRACE(isPCurvePeak);
+          const occ::handle<Geom2d_Curve> aPCurve = isPCurvePeak
+                                                      ? occ::handle<Geom2d_Curve>(aUVSpline)
+                                                      : occ::handle<Geom2d_Curve>(aFlatPCurve);
+          const occ::handle<Geom_Curve>   aCurve =
+            isPCurvePeak ? occ::handle<Geom_Curve>(aFlatCurve) : occ::handle<Geom_Curve>(aSpline);
+          const occ::handle<Adaptor3d_CurveOnSurface> aCoS =
+            new Adaptor3d_CurveOnSurface(new Geom2dAdaptor_Curve(aPCurve, aFirst, aLast),
+                                         new GeomAdaptor_Surface(new Geom_Plane(gp_Ax3())));
+          GeomLib_CheckCurveOnSurface aCheck(new GeomAdaptor_Curve(aCurve, aFirst, aLast));
+          aCheck.Perform(aCoS);
+          ASSERT_TRUE(aCheck.IsDone());
+          EXPECT_NEAR(aCheck.MaxDistance(), aHeight, 1.0e-12);
+          EXPECT_NEAR(aCheck.MaxParameter(), aPeakParameter, aWidth);
+          aCheck.Perform(aCoS, 0.5 * aHeight);
+          ASSERT_TRUE(aCheck.IsDone());
+          EXPECT_GT(aCheck.MaxDistance(), 0.5 * aHeight);
+        }
+      }
+    }
+  }
 }
 
