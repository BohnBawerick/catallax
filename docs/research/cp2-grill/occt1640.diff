+TEST(GeomLib_CheckCurveOnSurfaceTest, SeparateSurfaceMaximaAreRefined)
+{
+  const int aDegree   = Geom_BSplineSurface::MaxDegree();
+  double    aBinomial = 1.0;
+  for (int anIndex = 1; anIndex <= aDegree / 2; ++anIndex)
+  {
+    aBinomial *= double(aDegree - anIndex + 1) / anIndex;
+  }
+  const double     aNarrowPeak   = std::pow(1.0 - 1.0 / aDegree, aDegree - 1);
+  const double     aCentralBasis = std::ldexp(2.0 * aBinomial, -aDegree);
+  constexpr double aPeakGap      = 1.0e-6;
+  const double     aCentralHeight =
+    (aNarrowPeak - std::ldexp(double(aDegree), -aDegree) - aPeakGap) / aCentralBasis;
+  NCollection_Array2<gp_Pnt> aPoles(1, aDegree + 1, 1, 2);
+  for (int anIndex = 0; anIndex <= aDegree; ++anIndex)
+  {
+    const double aHeight = anIndex == 1                                           ? 1.0
+                           : anIndex == aDegree / 2 || anIndex == aDegree / 2 + 1 ? aCentralHeight
+                                                                                  : 0.0;
+    for (int aColumn = 0; aColumn < 2; ++aColumn)
+    {
+      aPoles.ChangeAt(anIndex, aColumn) = gp_Pnt(double(anIndex) / aDegree, aColumn, aHeight);
+    }
+  }
+  const double                     aKnotValues[]  = {0.0, 1.0};
+  const int                        aUMultValues[] = {aDegree + 1, aDegree + 1};
+  const int                        aVMultValues[] = {2, 2};
+  const NCollection_Array1<double> aKnots(aKnotValues[0], 1, 2);
+  const NCollection_Array1<int>    aUMults(aUMultValues[0], 1, 2), aVMults(aVMultValues[0], 1, 2);
+  const occ::handle<Geom_BSplineSurface> aSurface =
+    new Geom_BSplineSurface(aPoles, aKnots, aKnots, aUMults, aVMults, aDegree, 1);
+  for (const bool isReversed : {false, true})
+  {
+    SCOPED_TRACE(isReversed);
+    const double                 anOrigin = isReversed ? 1.0 : 0.0;
+    const double                 aSign    = isReversed ? -1.0 : 1.0;
+    const occ::handle<Geom_Line> aCurve =
+      new Geom_Line(gp_Ax1(gp_Pnt(anOrigin, 0.0, 0.0), gp_Dir(aSign, 0.0, 0.0)));
+    const occ::handle<Geom2d_Line> aPCurve =
+      new Geom2d_Line(gp_Lin2d(gp_Pnt2d(anOrigin, 0.0), gp_Dir2d(aSign, 0.0)));
+    GeomLib_CheckCurveOnSurface aCheck(new GeomAdaptor_Curve(aCurve, 0.0, 1.0));
+    aCheck.Perform(new Adaptor3d_CurveOnSurface(new Geom2dAdaptor_Curve(aPCurve, 0.0, 1.0),
+                                                new GeomAdaptor_Surface(aSurface)));
+    ASSERT_TRUE(aCheck.IsDone());
+    const double aKnownDistance = aSurface->EvalD0(1.0 / aDegree, 0.0).Z();
+    EXPECT_NEAR(aCheck.MaxDistance(), aKnownDistance, Precision::Confusion());
+  }
+}
